{
	"schemaVersion": 1,
	"id": "mcrec",
	"version": "${version}",
	"name": "mcrec",
	"description": "Client-side macro recorder: records your movement, look and hotbar input for a stretch of play and replays it, with a failsafe that stops playback if you drift off the recorded path.",
	"authors": [
		"Jakob"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/mcrec/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"mc.record.Mcrec"
		],
		"client": [
			"mc.record.McrecClient"
		]
	},
	"mixins": [
		{
			"config": "mcrec.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
